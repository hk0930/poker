<script>
// ===== AUTH =====
const USERS = {
  admin: 'yt-dlp2024',
  user: 'password123'
};

let currentUser = null;

function handleLogin() {
  const u = document.getElementById('username').value.trim();
  const p = document.getElementById('password').value;
  const err = document.getElementById('errorMsg');

  if (USERS[u] && USERS[u] === p) {
    currentUser = u;
    err.style.display = 'none';
    showApp();
  } else {
    err.style.display = 'block';
    document.getElementById('password').value = '';
    document.getElementById('password').style.borderColor = 'var(--danger)';
    setTimeout(() => document.getElementById('password').style.borderColor = '', 1500);
  }
}

function showApp() {
  document.getElementById('loginScreen').style.display = 'none';
  document.getElementById('appScreen').style.display = 'block';
  document.getElementById('userLabel').textContent = currentUser;
  document.getElementById('userAvatar').textContent = currentUser[0].toUpperCase();
  generateCommand();
}

function handleLogout() {
  currentUser = null;
  document.getElementById('loginScreen').style.display = 'flex';
  document.getElementById('appScreen').style.display = 'none';
  document.getElementById('loginScreen').style.animation = 'none';
  setTimeout(() => document.getElementById('loginScreen').style.animation = '', 10);
  document.getElementById('username').value = '';
  document.getElementById('password').value = '';
}

// Enter key support
document.addEventListener('keydown', e => {
  if (e.key === 'Enter' && document.getElementById('loginScreen').style.display !== 'none') {
    handleLogin();
  }
});

// ===== TABS =====
function switchTab(name) {
  document.querySelectorAll('.tab').forEach((t,i) => t.classList.toggle('active', ['download','command'][i] === name));
  document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));
  document.getElementById('tab-' + name).classList.add('active');
  if (name === 'command') generateCommand();
}

// ===== TOGGLES =====
function toggleSwitch(id) {
  document.getElementById(id).classList.toggle('on');
}

function isOn(id) {
  return document.getElementById(id).classList.contains('on');
}

// ===== COMMAND GENERATION =====
function generateCommand() {
  const url = document.getElementById('ytUrl').value.trim() || 'YOUR_URL_HERE';
  const quality = document.getElementById('quality').value;
  const format = document.getElementById('format').value;
  const cookies = document.getElementById('cookies').value.trim();
  const archive = document.getElementById('archive').value.trim();
  const output = document.getElementById('output').value.trim();

  let cmd = 'yt-dlp';
  if (cookies) cmd += ` \\\n  --cookies ${cookies}`;
  cmd += ' \\\n  -f bestaudio';
  cmd += ' \\\n  --extract-audio';
  cmd += ` \\\n  --audio-format ${format}`;
  cmd += ` \\\n  --audio-quality ${quality}`;
  if (output) cmd += ` \\\n  -o "${output}"`;
  if (isOn('t-metadata')) cmd += ' \\\n  --embed-metadata \\\n  --add-metadata';
  if (isOn('t-thumb')) cmd += ' \\\n  --embed-thumbnail';
  if (isOn('t-archive') && archive) cmd += ` \\\n  --download-archive ${archive}`;
  cmd += ` \\\n  "${url}"`;

  document.getElementById('commandPreview').textContent = cmd;
}

function copyCommand() {
  const text = document.getElementById('commandPreview').textContent;
  navigator.clipboard.writeText(text).then(() => {
    const btn = document.querySelector('.copy-btn');
    btn.textContent = '✓ コピー済';
    btn.style.color = 'var(--accent)';
    setTimeout(() => { btn.textContent = 'コピー'; btn.style.color = ''; }, 2000);
  });
}

// Auto-regenerate on input change
['ytUrl','quality','format','cookies','archive','output'].forEach(id => {
  const el = document.getElementById(id);
  if (el) el.addEventListener('input', generateCommand);
});
</script>

