border-radius: 8px;
padding: 9px 12px;
color: var(–text);
font-size: 13px;
font-family: ‘Space Mono’, monospace;
outline: none;
transition: border-color 0.2s;
-webkit-appearance: none;
}

.option-item select:focus,
.option-item input:focus {
